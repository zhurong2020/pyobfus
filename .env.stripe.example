# Stripe Configuration Template
# Copy this file to .env.stripe and fill in your actual keys
# NEVER commit .env.stripe to Git!

# Test Mode Keys (for local development)
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_TEST_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Live Mode Keys (after KYC approval - DO NOT use in development)
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE
STRIPE_LIVE_SECRET_KEY=sk_live_YOUR_SECRET_KEY_HERE

# Product and Price IDs
STRIPE_PRODUCT_ID=prod_YOUR_PRODUCT_ID
STRIPE_PRICE_ID=price_YOUR_PRICE_ID

# Webhook Secret (after deploying Cloudflare Worker)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Environment (test or live)
STRIPE_ENVIRONMENT=test
