#!/usr/bin/env bash
# pre-commit: block PII patterns and credential material from entering commits.
#
# Three independent scans, each with its own allowlist and its own bypass:
#
#   1. PII      — Origin: 2026-05-03 PII cleanup (V0.4_EXECUTION_LOG Sessions
#                 13-15) removed CCPC software-copyright filing materials from
#                 public history. This scan prevents reintroduction.
#   2. SECRETS  — Origin: 2026-09-07. The PII scan had no coverage for tokens,
#                 so a credential pasted into a file would have committed
#                 cleanly to this PUBLIC repo. Added after an Open VSX publish
#                 token was handled by hand and caught only by an ad-hoc grep.
#   3. CUSTOMER — Origin: 2026-10-29. Stripe object IDs and e-mail addresses
#                 outside an allowlist, in newly added lines only. Patterns
#                 live in customer-data-patterns.sh (shared with commit-msg).
#
# Setup (one-time per clone):
#     git config core.hooksPath .githooks
#
# Bypass one scan for a legitimate reference (they are separate on purpose —
# waving through a documented PII string must not also wave through a token):
#     PYOBFUS_ALLOW_PII=1 git commit ...
#     PYOBFUS_ALLOW_SECRET=1 git commit ...
#     PYOBFUS_ALLOW_CUSTOMER_DATA=1 git commit ...

set -eu

PII_PATTERN='诸嵘|陈启稚|qizhi_chen|身份证|/home/wuxia/'

# Allowlisted paths: files that legitimately discuss the cleanup itself.
# Anchored to repo root with -x for full-line match.
PII_ALLOWLIST_RE='docs/V0\.4_EXECUTION_LOG\.md|\.githooks/pre-commit|\.githooks/README\.md|CLAUDE\.md'

# Keep credential shapes aligned with pyobfus/core/secret_literals.py.
# High-signal credential prefixes/shapes only. Deliberately NOT generic
# entropy matching: this repo ships a secret *detector*, so broad heuristics
# would fight its own source and fixtures. Verified 2026-09-07 against every
# tracked file — zero pre-existing matches.
SECRET_PATTERN='ovsxat_|pypi-AgEIcHlwaS5vcmc|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|glpat-[A-Za-z0-9_-]{15,}|npm_[A-Za-z0-9]{30,}|sk-ant-api[0-9]{2}-|sk-proj-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[0-9A-Za-z-]{10,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

# Only the files that enumerate the patterns themselves.
SECRET_ALLOWLIST_RE='\.githooks/pre-commit|\.githooks/README\.md'

staged_files() {
    git diff --cached --name-only --diff-filter=AM \
        | grep -vxE "$1" \
        || true
}

fail_banner() {
    printf '============================================================\n' >&2
}

# ---------------------------------------------------------------- PII scan
if [[ "${PYOBFUS_ALLOW_PII:-0}" != "1" ]]; then
    mapfile -t pii_staged < <(staged_files "$PII_ALLOWLIST_RE")
    if (( ${#pii_staged[@]} > 0 )); then
        hits=$(git grep --cached -nE "$PII_PATTERN" -- "${pii_staged[@]}" 2>/dev/null || true)
        if [[ -n "$hits" ]]; then
            fail_banner
            cat >&2 <<EOF
ERROR: pre-commit blocked — PII pattern detected in staged content
============================================================

$hits

Blocked patterns: 诸嵘 / 陈启稚 / qizhi_chen / 身份证 / /home/wuxia/

Why this hook exists:
  2026-05-03 git history rewrite removed CCPC software-copyright
  filing materials and personal identifiers from this public repo.
  This hook prevents accidental reintroduction.

If the match is legitimate (e.g. you are documenting the cleanup):
  1. add the file path to PII_ALLOWLIST_RE in .githooks/pre-commit, or
  2. bypass once with: PYOBFUS_ALLOW_PII=1 git commit ...

============================================================
EOF
            exit 1
        fi
    fi
fi

# ------------------------------------------------------------ secret scan
if [[ "${PYOBFUS_ALLOW_SECRET:-0}" != "1" ]]; then
    mapfile -t sec_staged < <(staged_files "$SECRET_ALLOWLIST_RE")
    if (( ${#sec_staged[@]} > 0 )); then
        # Location only — never echo the matched line, or the banner itself
        # would print the credential into the terminal and the shell history.
        locs=$(git grep --cached -nE "$SECRET_PATTERN" -- "${sec_staged[@]}" 2>/dev/null \
                 | cut -d: -f1,2 || true)
        if [[ -n "$locs" ]]; then
            fail_banner
            cat >&2 <<EOF
ERROR: pre-commit blocked — credential material detected in staged content
============================================================

Locations (content deliberately not printed):

$locs

Recognised shapes: Open VSX / PyPI / GitHub / GitLab / npm / Anthropic /
OpenAI / AWS / Slack / Google API tokens, and PEM private keys.

Why this hook exists:
  This is a PUBLIC repo. Credentials belong in Vaultwarden, read at use
  time into an env var — never in a tracked file, and never in CI config.

What to do:
  1. remove the credential from the file and unstage it;
  2. if it was ever real, ROTATE it — a local remove is not a rotation;
  3. only if this is a documented example, bypass once with:
     PYOBFUS_ALLOW_SECRET=1 git commit ...

============================================================
EOF
            exit 1
        fi
    fi
fi

# --------------------------------------------------------- customer scan
# Added lines only: existing tracked content is not re-litigated on every
# edit, and the scan stays fast. Skipped: the hook files themselves and the
# PII-cleanup log (already allowlisted by scan 1).
CUSTOMER_ALLOWLIST_RE='\.githooks/.*|docs/V0\.4_EXECUTION_LOG\.md'
if [[ "${PYOBFUS_ALLOW_CUSTOMER_DATA:-0}" != "1" ]]; then
    # shellcheck source=customer-data-patterns.sh
    source "$(dirname "$0")/customer-data-patterns.sh"
    mapfile -t cust_staged < <(staged_files "$CUSTOMER_ALLOWLIST_RE")
    if (( ${#cust_staged[@]} > 0 )); then
        locs=$(git diff --cached -U0 --no-color --no-ext-diff -- "${cust_staged[@]}" \
                 | awk '/^\+\+\+ b\//{f=substr($0,7);next}
                        /^@@/{match($0,/\+[0-9]+/);ln=substr($0,RSTART+1,RLENGTH-1)+0;next}
                        /^\+/{print f ":" ln ":" substr($0,2); ln++}' \
                 | customer_candidate_filter | customer_scan_records 1)
        if [[ -n "$locs" ]]; then
            fail_banner
            cat >&2 <<EOF
ERROR: pre-commit blocked — possible customer/business data in added lines
============================================================

Locations (content deliberately not printed):

$locs

This is a PUBLIC repo. Customer names, e-mails, addresses, tax IDs and
Stripe object IDs belong in git-ignored docs/internal/ or private memory;
public docs keep one sentence plus a pointer (AGENTS.md, "Public vs
private records").

What to do:
  1. move the detail to the private record and abstract the public text;
  2. if an address is a legitimate public one, add it to
     CUSTOMER_EMAIL_ALLOW_RE in .githooks/customer-data-patterns.sh;
  3. only for a reviewed false positive, bypass once with:
     PYOBFUS_ALLOW_CUSTOMER_DATA=1 git commit ...

============================================================
EOF
            exit 1
        fi
    fi
fi

exit 0
